{
  "info": {
    "name": "Solar API",
    "description": "Requests and tests for the solar estimator's Django API. Pick an environment (for example \"Local\") that defines `baseUrl`.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/health",
          "host": ["{{baseUrl}}"],
          "path": ["api", "health"]
        },
        "description": "Reports whether the API is up and can query PostGIS. Answers 503 when the database is unreachable."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status is 200\", () => {",
              "  pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"answers with JSON\", () => {",
              "  pm.response.to.have.header(\"Content-Type\", \"application/json\");",
              "});",
              "",
              "pm.test(\"reports status ok\", () => {",
              "  pm.expect(pm.response.json().status).to.eql(\"ok\");",
              "});",
              "",
              "pm.test(\"names a PostGIS 3.x version\", () => {",
              "  pm.expect(pm.response.json().postgis).to.match(/^3\\.\\d+/);",
              "});",
              "",
              "pm.test(\"responds within 1 second\", () => {",
              "  pm.expect(pm.response.responseTime).to.be.below(1000);",
              "});"
            ]
          }
        }
      ],
      "response": []
    }
  ]
}
