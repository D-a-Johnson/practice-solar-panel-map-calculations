{
  "info": {
    "name": "Solar API",
    "description": "Requests and tests for the solar estimator's Django API. Pick an environment (for example \"Local\") that defines `baseUrl`.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "health"
          ]
        },
        "description": "Reports whether the API is up and can query PostGIS. Answers 503 when the database is unreachable."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status is 200\", () => {",
              "  pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"answers with JSON\", () => {",
              "  pm.response.to.have.header(\"Content-Type\", \"application/json\");",
              "});",
              "",
              "pm.test(\"reports status ok\", () => {",
              "  pm.expect(pm.response.json().status).to.eql(\"ok\");",
              "});",
              "",
              "pm.test(\"names a PostGIS 3.x version\", () => {",
              "  pm.expect(pm.response.json().postgis).to.match(/^3\\.\\d+/);",
              "});",
              "",
              "pm.test(\"responds within 1 second\", () => {",
              "  pm.expect(pm.response.responseTime).to.be.below(1000);",
              "});"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "Building at Moltkestraße 18",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/buildings/at?lon=7.843463&lat=47.994500",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "buildings",
            "at"
          ],
          "query": [
            {
              "key": "lon",
              "value": "7.843463"
            },
            {
              "key": "lat",
              "value": "47.994500"
            }
          ]
        },
        "description": "Imports the LoD2 tile on first use, then returns the building under the point with its roof faces and the walls taken from its footprint."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const body = pm.response.json();",
              "",
              "pm.test(\"status is 200\", () => {",
              "  pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"finds Moltkestraße 18\", () => {",
              "  pm.expect(body.gml_id).to.eql(\"DEBW_0010007TuWn\");",
              "  pm.expect(body.street).to.eql(\"Moltkestraße\");",
              "  pm.expect(body.house_number).to.eql(\"18\");",
              "});",
              "",
              "pm.test(\"lists the west roof face first\", () => {",
              "  const roof = body.roofs[0];",
              "  pm.expect(roof.kind).to.eql(\"roof\");",
              "  pm.expect(roof.direction).to.eql(\"W\");",
              "  pm.expect(roof.tilt).to.be.within(39, 40);",
              "});",
              "",
              "pm.test(\"footprint is GeoJSON in lon/lat\", () => {",
              "  pm.expect(body.footprint.type).to.eql(\"MultiPolygon\");",
              "  const [lon, lat] = body.footprint.coordinates[0][0][0];",
              "  pm.expect(lon).to.be.within(7.8, 7.9);",
              "  pm.expect(lat).to.be.within(47.9, 48.0);",
              "});",
              "",
              "pm.test(\"lists its walls for balcony panels, widest first\", () => {",
              "  pm.expect(body.walls.map((wall) => wall.direction)).to.eql([\"S\", \"N\", \"W\", \"E\"]);",
              "  pm.expect(body.walls[0].tilt).to.eql(90);",
              "});"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "Yield per kWp, west roof of Moltkestraße 18",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/estimates?lat=47.9945&lon=7.843463&tilt=39.3&azimuth=280.1",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "estimates"
          ],
          "query": [
            {
              "key": "lat",
              "value": "47.9945"
            },
            {
              "key": "lon",
              "value": "7.843463"
            },
            {
              "key": "tilt",
              "value": "39.3"
            },
            {
              "key": "azimuth",
              "value": "280.1"
            }
          ]
        },
        "description": "PVGIS yield for 1 kWp on a 39° west-facing roof; clients multiply by their own kWp. The first call asks PVGIS, later calls come from the cache."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const body = pm.response.json();",
              "",
              "pm.test(\"status is 200\", () => {",
              "  pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"has twelve months that add up to the year\", () => {",
              "  pm.expect(body.monthly_kwh_per_kwp).to.have.lengthOf(12);",
              "  const sum = body.monthly_kwh_per_kwp.reduce((a, b) => a + b, 0);",
              "  pm.expect(sum).to.be.closeTo(body.annual_kwh_per_kwp, 2);",
              "});",
              "",
              "pm.test(\"yield is plausible for a west roof in Freiburg\", () => {",
              "  pm.expect(body.annual_kwh_per_kwp).to.be.within(750, 850);",
              "});"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "Assumptions",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/assumptions",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "assumptions"
          ]
        },
        "description": "Default values for the economics (prices, tariff, self-consumption, cost, CO₂ factor), each with its source and date. Editable in the Django admin."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const body = pm.response.json();",
              "",
              "pm.test(\"status is 200\", () => {",
              "  pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"has all five assumptions with value and source\", () => {",
              "  [\"electricity_price\", \"feed_in_tariff\", \"self_consumption_share\", \"system_cost_per_kwp\", \"grid_co2_factor\"].forEach((key) => {",
              "    pm.expect(body[key].value).to.be.above(0);",
              "    pm.expect(body[key].source_url).to.match(/^https:\\/\\//);",
              "  });",
              "});"
            ]
          }
        }
      ],
      "response": []
    }
  ]
}
