# Copy to .env and adjust. .env is git-ignored; this template is committed.

# Database (read by docker-compose.yml and by Django)
POSTGRES_DB=solar
POSTGRES_USER=solar
POSTGRES_PASSWORD=solar
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Django (the "django-insecure-" prefix makes `manage.py check --deploy` flag this key)
DJANGO_SECRET_KEY=django-insecure-dev-only-never-use-in-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
